NULL
5
NULL
6
NULL

query I nosort
SELECT id FROM tv WHERE a + b > 1 ORDER BY id
----
1
2

query I nosort
SELECT 1 + NULL
----
NULL

query T nosort
SELECT 'a' || NULL
----
NULL

