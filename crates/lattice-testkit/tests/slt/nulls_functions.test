# NULL through arithmetic, concatenation, COALESCE, NULLIF, aggregates, DISTINCT and GROUP BY.

statement ok
CREATE TABLE tv (id INT PRIMARY KEY, a INT, b INT)

statement ok
INSERT INTO tv VALUES (1, 1, 1), (2, 1, 2), (3, NULL, 1), (4, 1, NULL), (5, NULL, NULL), (6, 2, NULL)

statement ok
CREATE TABLE nl (id INT PRIMARY KEY, s TEXT)

statement ok
INSERT INTO nl VALUES (1, 'abc'), (2, NULL), (3, 'abd')

query II nosort
SELECT id, a + b FROM tv ORDER BY id
----
