# Aggregates skip NULL; count(*) does not.
query IIIIIII nosort
SELECT count(*), count(a), count(b), sum(a), sum(b), min(a), max(a) FROM tv
----
6
4
3
5
4
1
2

query II nosort
SELECT round(avg(a)), round(avg(b)) FROM tv
----
1
1

query I nosort
SELECT count(DISTINCT a) FROM tv
----
2

# NULLs form one group.
query II nosort
SELECT a, count(*) FROM tv GROUP BY a ORDER BY a NULLS LAST
----
1
3
2
1
NULL
2

query I nosort
SELECT a FROM tv GROUP BY a HAVING count(*) = 2
----
NULL

query I nosort
SELECT DISTINCT a FROM tv ORDER BY a NULLS FIRST
----
NULL
1
2

# COALESCE needs one common type: 'x' cannot be an integer.
statement error 22P02
SELECT coalesce(1, 'x')

# DIFFERS FROM POSTGRESQL BY DESIGN: CASE and greatest() are not in the subset.
statement error 0A000
SELECT CASE WHEN a IS NULL THEN 0 ELSE a END FROM tv

statement error 0A000
SELECT greatest(a, b) FROM tv
