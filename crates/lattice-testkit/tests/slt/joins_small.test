# DIFFERS FROM POSTGRESQL BY DESIGN: only INNER, LEFT and CROSS joins with ON are in the subset.
statement error 0A000
SELECT * FROM pa RIGHT JOIN pb ON pb.a_id = pa.id

statement error 0A000
SELECT * FROM pa FULL JOIN pb ON pb.a_id = pa.id

statement error 0A000
SELECT * FROM pa JOIN pb USING (id)

statement error 0A000
SELECT * FROM pa, LATERAL (SELECT pa.id) AS s

statement error 0A000
SELECT * FROM pa JOIN (SELECT * FROM pb) AS s ON s.a_id = pa.id
