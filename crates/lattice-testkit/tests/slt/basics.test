# The first scripts of the declared SQL subset. They define what the engine must answer; an engine
# is wired in when the SQL layer exists.

statement ok
CREATE TABLE notes (id INT PRIMARY KEY, title TEXT, score INT)

statement ok
INSERT INTO notes VALUES (1, 'alpha', 10), (2, 'beta', 20), (3, 'gamma', 20)

query ITI rowsort
SELECT id, title, score FROM notes WHERE score >= 20
----
2
beta
20
