# Constraints and their SQLSTATEs: PRIMARY KEY and UNIQUE violations are 23505, a missing value for
# a NOT NULL or primary key column is 23502, a value too long is 22001. A failed statement changes
# nothing, even when some of its rows were fine.

statement ok
CREATE TABLE u (id INT PRIMARY KEY, email TEXT UNIQUE, name TEXT NOT NULL, age INT DEFAULT 18)

statement ok
INSERT INTO u (id, email, name) VALUES (1, 'a@x', 'ann'), (2, 'b@x', 'bob')

# Defaults.
query ITTI nosort
SELECT id, email, name, age FROM u ORDER BY id
----
1
a@x
ann
18
2
b@x
bob
18

# Primary key.
statement error 23505
INSERT INTO u VALUES (1, 'new@x', 'dup', 1)

statement error 23502
INSERT INTO u (email, name) VALUES ('c@x', 'cat')

statement error 23502
INSERT INTO u VALUES (NULL, 'c@x', 'cat', 1)

statement error 23505
UPDATE u SET id = 1 WHERE id = 2

statement error 23502
UPDATE u SET id = NULL WHERE id = 2

# UNIQUE: duplicates are refused, NULLs are not duplicates, text is compared exactly.
statement error 23505
INSERT INTO u VALUES (3, 'a@x', 'dup', 1)

statement ok
INSERT INTO u VALUES (3, NULL, 'cat', 1), (4, NULL, 'dan', 1)

statement ok
INSERT INTO u VALUES (5, 'A@x', 'eve', 1)

statement error 23505
UPDATE u SET email = 'a@x' WHERE id = 2

statement ok
UPDATE u SET email = 'b@x' WHERE id = 2

statement ok
UPDATE u SET email = NULL WHERE id = 5

# NOT NULL.
statement error 23502
INSERT INTO u (id, email) VALUES (6, 'f@x')

statement error 23502
INSERT INTO u VALUES (6, 'f@x', NULL, 1)

statement error 23502
UPDATE u SET name = NULL WHERE id = 1

# Atomic statements: a later row that fails undoes the earlier ones.
statement error 23505
INSERT INTO u VALUES (20, 'm@x', 'm', 1), (1, 'n@x', 'n', 1)

statement error 23505
INSERT INTO u VALUES (21, 'same@x', 'p', 1), (22, 'same@x', 'q', 1)

statement error 23505
UPDATE u SET email = 'z@x' WHERE id IN (1, 2)

query I nosort
SELECT count(*) FROM u WHERE id >= 20
----
0

query IT nosort
SELECT id, email FROM u WHERE id <= 2 ORDER BY id
----
1
a@x
2
b@x

# A deleted key can be used again.
statement ok
DELETE FROM u WHERE id = 1

statement ok
INSERT INTO u VALUES (1, 'a@x', 'ann again', 30)

query TI nosort
SELECT name, age FROM u WHERE id = 1
----
ann again
30

query I nosort
SELECT count(*) FROM u
----
5

# A composite primary key and a composite unique constraint.
statement ok
CREATE TABLE pk2 (a INT, b INT, c TEXT, PRIMARY KEY (a, b), UNIQUE (c, b))

statement ok
INSERT INTO pk2 VALUES (1, 1, 'x'), (1, 2, 'x'), (2, 1, 'y')

statement error 23505
INSERT INTO pk2 VALUES (1, 1, 'z')

statement error 23505
INSERT INTO pk2 VALUES (3, 1, 'x')

statement error 23502
INSERT INTO pk2 VALUES (NULL, 1, 'q')

statement ok
INSERT INTO pk2 VALUES (3, 2, NULL), (4, 2, NULL)

query I nosort
SELECT count(*) FROM pk2
----
5

# Value limits.
statement ok
CREATE TABLE vc (id INT PRIMARY KEY, code VARCHAR(3))

statement ok
INSERT INTO vc VALUES (1, 'abc')

statement error 22001
INSERT INTO vc VALUES (2, 'abcd')

statement error 22P02
INSERT INTO vc VALUES ('two', 'ab')

statement ok
CREATE TABLE amounts (id INT PRIMARY KEY, amt NUMERIC(5, 2))

statement ok
INSERT INTO amounts VALUES (1, 123.456), (2, 0.1), (3, 999.99)

statement error 22003
INSERT INTO amounts VALUES (4, 1000)

query IR nosort
SELECT id, amt FROM amounts ORDER BY id
----
1
123.46
2
0.10
3
999.99

# DIFFERS FROM POSTGRESQL BY DESIGN: foreign keys, CHECK, named constraints and generated columns
# are not in the subset.
statement error 0A000
CREATE TABLE child (id INT PRIMARY KEY, parent INT REFERENCES u (id))

statement error 0A000
CREATE TABLE chk (id INT PRIMARY KEY, n INT CHECK (n > 0))

statement error 0A000
CREATE TABLE named (id INT, CONSTRAINT pk_named PRIMARY KEY (id))

statement error 0A000
CREATE TABLE dflt (id INT PRIMARY KEY, made TIMESTAMPTZ DEFAULT now())
