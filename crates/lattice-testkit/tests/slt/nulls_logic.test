# NULL and three-valued logic in WHERE. Rows whose predicate is NULL are filtered out, exactly like
# rows whose predicate is false; NOT NULL is NULL. Nothing here projects a boolean, so the results
# are plain integers.

statement ok
CREATE TABLE tv (id INT PRIMARY KEY, a INT, b INT)

statement ok
INSERT INTO tv VALUES (1, 1, 1), (2, 1, 2), (3, NULL, 1), (4, 1, NULL), (5, NULL, NULL), (6, 2, NULL)

query I nosort
SELECT id FROM tv WHERE a = b ORDER BY id
----
1

query I nosort
SELECT id FROM tv WHERE a <> b ORDER BY id
----
2

query I nosort
SELECT id FROM tv WHERE NOT (a = b) ORDER BY id
----
2

query I nosort
SELECT id FROM tv WHERE a = b OR a <> b ORDER BY id
----
1
2

# NULL OR true is true, NULL OR false is NULL.
query I nosort
SELECT id FROM tv WHERE a = 1 OR b = 1 ORDER BY id
----
1
2
3
4

query I nosort
SELECT id FROM tv WHERE a = 1 OR b = 2 ORDER BY id
----
1
2
4

# NULL AND false is false, NULL AND true is NULL.
query I nosort
SELECT id FROM tv WHERE a = 1 AND b = 1 ORDER BY id
----
1

query I nosort
SELECT id FROM tv WHERE NOT (a = 1 AND b = 1) ORDER BY id
----
2
6

query I nosort
SELECT id FROM tv WHERE a IS NULL ORDER BY id
----
3
5

query I nosort
SELECT id FROM tv WHERE a IS NOT NULL AND b IS NULL ORDER BY id
----
4
6

# Comparing with NULL is never true.
query I nosort
SELECT count(*) FROM tv WHERE a = NULL
----
0

query I nosort
SELECT count(*) FROM tv WHERE a <> NULL
----
0

query I nosort
SELECT count(*) FROM tv WHERE NULL = NULL
----
0

query I nosort
SELECT count(*) FROM tv WHERE NULL
----
0

# Constant truth tables.
query I nosort
SELECT count(*) FROM tv WHERE NULL OR true
----
6

query I nosort
SELECT count(*) FROM tv WHERE NULL AND false
----
0

query I nosort
SELECT count(*) FROM tv WHERE NOT (NULL AND false)
----
6

query I nosort
SELECT count(*) FROM tv WHERE NOT (NULL OR false)
----
0

query I nosort
SELECT count(*) FROM tv WHERE (NULL AND false) IS NULL
----
0

query I nosort
SELECT count(*) FROM tv WHERE (NULL AND true) IS NULL
----
6

query I nosort
SELECT count(*) FROM tv WHERE (NULL OR true) IS NULL
----
0

query I nosort
SELECT count(*) FROM tv WHERE (NULL OR false) IS NULL
----
6

# IN with a NULL in the list: a match is true, a miss is NULL, so NOT IN never selects a row.
query I nosort
SELECT count(*) FROM tv WHERE a IN (2, NULL)
----
1

query I nosort
SELECT count(*) FROM tv WHERE a IN (1, NULL)
----
3

query I nosort
SELECT count(*) FROM tv WHERE a NOT IN (2, NULL)
----
0

query I nosort
SELECT count(*) FROM tv WHERE a NOT IN (3, 4)
----
4

# BETWEEN is x >= low AND x <= high, so a false bound beats a NULL one.
query I nosort
SELECT id FROM tv WHERE b BETWEEN 1 AND 2 ORDER BY id
----
1
2
3

query I nosort
SELECT id FROM tv WHERE b NOT BETWEEN 2 AND 3 ORDER BY id
----
1
3

query I nosort
SELECT count(*) FROM tv WHERE b BETWEEN NULL AND 5
----
0

query I nosort
SELECT id FROM tv WHERE b NOT BETWEEN 5 AND NULL ORDER BY id
----
1
2
3

statement ok
CREATE TABLE nl (id INT PRIMARY KEY, s TEXT)

statement ok
INSERT INTO nl VALUES (1, 'abc'), (2, NULL), (3, 'abd')

query I nosort
SELECT count(*) FROM nl WHERE s LIKE 'ab%'
----
2

query I nosort
SELECT id FROM nl WHERE s NOT LIKE 'abc' ORDER BY id
----
3

query I nosort
SELECT count(*) FROM nl WHERE s LIKE '%'
----
2

query I nosort
SELECT count(*) FROM nl WHERE s = s
----
2

# DIFFERS FROM POSTGRESQL BY DESIGN: PostgreSQL accepts IS [NOT] DISTINCT FROM and the boolean IS
# forms; the subset has IS [NOT] NULL only and refuses the rest with 0A000.
statement error 0A000
SELECT id FROM tv WHERE a IS DISTINCT FROM b

statement error 0A000
SELECT id FROM tv WHERE a IS NOT DISTINCT FROM b

statement error 0A000
SELECT id FROM tv WHERE (a = b) IS TRUE

statement error 0A000
SELECT id FROM tv WHERE (a = b) IS NOT UNKNOWN

statement error 0A000
SELECT id FROM tv WHERE a ISNULL

statement error 0A000
SELECT id FROM tv WHERE a NOTNULL

statement error 0A000
SELECT id FROM tv WHERE a = ANY (SELECT b FROM tv)

statement error 42703
SELECT id FROM tv WHERE c IS NULL
