# Uncorrelated scalar and IN subqueries, and the NULL traps around them. EXISTS, ANY/ALL and
# subqueries in FROM are refused with 0A000. Correlated subqueries are also refused, but only when
# the query is bound, so they are not listed here (this corpus is also read by the parser tests,
# which see syntax only).

statement ok
CREATE TABLE s1 (id INT PRIMARY KEY, v INT)

statement ok
CREATE TABLE s2 (id INT PRIMARY KEY, ref INT)

statement ok
INSERT INTO s1 VALUES (1, 10), (2, 20), (3, 30), (4, NULL)

statement ok
INSERT INTO s2 VALUES (1, 1), (2, 3), (3, NULL), (4, 9)

query I nosort
SELECT id FROM s1 WHERE v = (SELECT max(v) FROM s1)
----
3

query II nosort
SELECT id, (SELECT max(v) FROM s1) FROM s1 WHERE id <= 2 ORDER BY id
----
1
30
2
30

query I nosort
SELECT (SELECT count(*) FROM s2) + 1
----
5

query I nosort
SELECT id FROM s1 WHERE v > (SELECT min(v) FROM s1) ORDER BY id
----
2
3

# A scalar subquery with no row is NULL, so the comparison selects nothing.
query I nosort
SELECT (SELECT v FROM s1 WHERE id = 99)
----
NULL

query I nosort
SELECT count(*) FROM s1 WHERE v = (SELECT v FROM s1 WHERE id = 99)
----
0

query I nosort
SELECT id FROM s1 WHERE id IN (SELECT ref FROM s2) ORDER BY id
----
1
3

query I nosort
SELECT id FROM s1 WHERE v IN (SELECT max(v) FROM s1)
----
3

# NOT IN over a column that contains NULL selects nothing; without the NULL it selects the rest.
query I nosort
SELECT count(*) FROM s1 WHERE id NOT IN (SELECT ref FROM s2)
----
0

query I nosort
SELECT id FROM s1 WHERE id NOT IN (SELECT ref FROM s2 WHERE ref IS NOT NULL) ORDER BY id
----
2
4

query I nosort
SELECT count(*) FROM s1 WHERE id IN (SELECT ref FROM s2 WHERE id > 99)
----
0

query I nosort
SELECT count(*) FROM s1 WHERE id NOT IN (SELECT ref FROM s2 WHERE id > 99)
----
4

statement error 21000
SELECT (SELECT v FROM s1)

statement error 21000
SELECT id FROM s1 WHERE v = (SELECT ref FROM s2 WHERE ref IS NOT NULL)

statement error 42703
SELECT id FROM s1 WHERE id IN (SELECT nope FROM s2)

# DIFFERS FROM POSTGRESQL BY DESIGN: EXISTS, ANY/ALL and derived tables are not in the subset.
statement error 0A000
SELECT id FROM s1 WHERE EXISTS (SELECT 1 FROM s2)

statement error 0A000
SELECT id FROM s1 WHERE NOT EXISTS (SELECT 1 FROM s2 WHERE ref = 1)

statement error 0A000
SELECT id FROM s1 WHERE id = ANY (SELECT ref FROM s2)

statement error 0A000
SELECT id FROM s1 WHERE id > ALL (SELECT ref FROM s2)

statement error 0A000
SELECT x.id FROM (SELECT id FROM s1) AS x
