# LIMIT and OFFSET edges: zero, past the end, NULL, expressions, negative values, either clause
# order, and their interaction with aggregates. A query that returns no rows has nothing after
# the ---- line.

statement ok
CREATE TABLE lo (id INT PRIMARY KEY, v INT NOT NULL)

statement ok
INSERT INTO lo VALUES (1, 10), (2, 20), (3, 30), (4, 40), (5, 50)

query I nosort
SELECT id FROM lo ORDER BY id LIMIT 0
----

query I nosort
SELECT id FROM lo ORDER BY id LIMIT 1
----
1

query I nosort
SELECT id FROM lo ORDER BY id LIMIT 10
----
1
2
3
4
5

query I nosort
SELECT id FROM lo ORDER BY id OFFSET 0
----
1
2
3
4
5

query I nosort
SELECT id FROM lo ORDER BY id OFFSET 4
----
5

query I nosort
SELECT id FROM lo ORDER BY id OFFSET 5
----

query I nosort
SELECT id FROM lo ORDER BY id OFFSET 10
----

query I nosort
SELECT id FROM lo ORDER BY id LIMIT 2 OFFSET 4
----
5

query I nosort
SELECT id FROM lo ORDER BY id LIMIT 3 OFFSET 1
----
2
3
4

query I nosort
SELECT id FROM lo ORDER BY id OFFSET 2 LIMIT 2
----
3
4

query I nosort
SELECT id FROM lo ORDER BY id DESC LIMIT 2 OFFSET 1
----
4
3

query I nosort
SELECT id FROM lo ORDER BY id LIMIT 1 + 1
----
1
2

query I nosort
SELECT id FROM lo WHERE v > 20 ORDER BY id LIMIT 5
----
3
4
5

query I nosort
SELECT id FROM lo WHERE v > 100 ORDER BY id LIMIT 5
----

# LIMIT NULL means no limit and OFFSET NULL means no offset.
query I nosort
SELECT id FROM lo ORDER BY id LIMIT NULL
----
1
2
3
4
5

query I nosort
SELECT id FROM lo ORDER BY id OFFSET NULL
----
1
2
3
4
5

# LIMIT and OFFSET apply after aggregation: one aggregate row, then skipped.
query I nosort
SELECT count(*) FROM lo LIMIT 1
----
5

query I nosort
SELECT count(*) FROM lo OFFSET 1
----

query I nosort
SELECT count(*) FROM lo LIMIT 0
----

query II nosort
SELECT v / 20, count(*) FROM lo GROUP BY v / 20 ORDER BY v / 20 LIMIT 2 OFFSET 1
----
1
2
2
2

# LIMIT after DISTINCT.
query I nosort
SELECT DISTINCT v / 20 FROM lo ORDER BY v / 20 LIMIT 2
----
0
1

statement error 2201W
SELECT id FROM lo ORDER BY id LIMIT -1

statement error 2201X
SELECT id FROM lo ORDER BY id OFFSET -1

# DIFFERS FROM POSTGRESQL BY DESIGN: LIMIT ALL, OFFSET ... ROWS and FETCH FIRST are not in the subset.
statement error 0A000
SELECT id FROM lo ORDER BY id LIMIT ALL

statement error 0A000
SELECT id FROM lo ORDER BY id OFFSET 1 ROWS

statement error 0A000
SELECT id FROM lo ORDER BY id FETCH FIRST 2 ROWS ONLY

statement error 42601
SELECT id FROM lo LIMIT
