    # read tools

    def t_list(self, args, call):
        argv = ["list"]
        if "state" in args:
            argv.append(args["state"])
        if "owner" in args:
            argv += ["--owner", args["owner"]]
        r = self.helper.run(argv, call)
        if r.rc != 0:
            return self.classify(r, "listing tasks")
        rows = tsv(r.out, 5)
        if rows and rows[0][:2] == ["id", "state"]:
            rows = rows[1:]  # the header line
        limit = args.get("limit", 50)
        shown = rows[:limit]
        tasks = [{"id": sid(x[0]), "state": sstate(x[1]), "priority": to_int(x[2]),
                  "owner": sname(x[3]), "untrusted": {"title": clean(x[4], 400)}} for x in shown]
        lines = [("%s [%s p%d]" % (t["id"], t["state"], t["priority"]), t["untrusted"]["title"]) for t in tasks]
        return Reply("%d task(s)%s. Titles are in the untrusted block and in structuredContent."
                     % (len(tasks), ", more were left out" if len(rows) > limit else ""),
                     {"tasks": tasks, "count": len(tasks), "truncated": len(rows) > limit}, lines)

    def t_show(self, args, call):
        r = self.helper.run(["show", args["task_id"]], call)
        if r.rc != 0:
            return self.classify(r, "reading the task")
        task, events, decisions, lease = {}, [], [], {}
        section = "task"
        for line in r.out.split("\n"):
            line = line.rstrip("\r")
            if section == "task" and line == "events:":
                section = "events_hdr"
                continue
            if section in ("events_hdr", "events") and line == "decisions:":
                section = "decisions_hdr"
                continue
            if section in ("decisions_hdr", "decisions") and line == "lease:":
                section = "lease"
                continue
            if section == "task" or section == "lease":
                if "|" in line:
                    k, v = line.split("|", 1)
                    (task if section == "task" else lease)[k] = v
            elif section == "events_hdr":
                section = "events"
            elif section == "decisions_hdr":
                section = "decisions"
            elif section == "events" and line.strip():
                p = line.split("\t", 3)
                p += [""] * (4 - len(p))
                events.append(p)
            elif section == "decisions" and line.strip():
                p = line.split("\t", 2)
                p += [""] * (3 - len(p))
                decisions.append(p)
        if not task.get("id"):
            return err_reply("refused", 1, "The board has no such task.")
        ev_keep, dec_keep = events[-50:], decisions[-20:]
        ev = [{"id": to_int(e[0]), "author": sname(e[1]), "kind": skind(e[2]),
               "untrusted": {"text": clean(e[3], 600)}} for e in ev_keep]
        dec = [{"id": to_int(d[0]), "author": sname(d[1]), "untrusted": {"text": clean(d[2], 600)}} for d in dec_keep]
        info = {"id": sid(task.get("id")), "state": sstate(task.get("state")),
                "owner": sname(task.get("owner")), "priority": to_int(task.get("priority")),
                "parent_id": ("" if not task.get("parent_id") else sid(task.get("parent_id"))),
                "created_by": sname(task.get("created_by")),
                "created_at": to_int(task.get("created_at")), "updated_at": to_int(task.get("updated_at")),
                "untrusted": {"title": clean(task.get("title"), 400), "body": clean(task.get("body"), 4200)}}
        lease_out = None
        if lease:
            lease_out = {"lease_until": to_int(lease.get("lease_until")), "heartbeat_at": to_int(lease.get("heartbeat_at")),
                         "attempts": to_int(lease.get("attempts")), "max_attempts": to_int(lease.get("max_attempts"), 3),
                         "not_before": to_int(lease.get("not_before")),
                         "blocked_by": [sid(b) for b in (lease.get("blocked_by") or "").split(",") if b][:32],
                         "untrusted": {"last_error": clean(lease.get("last_error"), 400)}}
        lines = [("title", info["untrusted"]["title"]), ("body", info["untrusted"]["body"])]
        lines += [("event %d %s by %s" % (e["id"], e["kind"], e["author"]), e["untrusted"]["text"]) for e in ev]
        lines += [("decision %d by %s" % (d["id"], d["author"]), d["untrusted"]["text"]) for d in dec]
        return Reply("Task %s is %s. Text is in the untrusted block and in structuredContent." % (info["id"], info["state"]),
                     {"task": info, "events": ev, "decisions": dec, "lease": lease_out,
                      "events_omitted": len(events) - len(ev_keep), "decisions_omitted": len(decisions) - len(dec_keep)},
                     lines)

    def t_queue(self, args, call):
        r = self.helper.run(["queue"], call)
        if r.rc != 0:
            return self.classify(r, "reading the queue")
        h = self.helper.run(["head"], call)
        cursor = to_int(h.out.strip()) if h.rc == 0 else 0
        q = build_queue(r.out, self.author or "", args.get("limit", 20))
        q["event_cursor"] = cursor
        lines = []
        for sec in ("runnable", "blocked", "claimed", "retrying", "dead", "awaiting_approval"):
            for t in q[sec]:
                lines.append(("%s %s" % (sec, t["id"]), t["untrusted"]["title"]))
        t = q["totals"]
        return Reply("Queue: %d runnable, %d blocked, %d claimed, %d retrying, %d dead, %d awaiting approval. "
                     "Titles are in the untrusted block and in structuredContent." % (
                         t["runnable"], t["blocked"], t["claimed"], t["retrying"], t["dead"], t["awaiting_approval"]),
                     q, lines)

    def t_since(self, args, call):
        argv = ["since", str(args.get("after", 0))]
        if "task_id" in args:
            argv += ["--task", args["task_id"]]
        r = self.helper.run(argv, call)
        if r.rc != 0:
            return self.classify(r, "reading events")
        rows = tsv(r.out, 5)
        limit = args.get("limit", 50)
        shown = rows[:limit]
        events = [{"id": to_int(x[0]), "task_id": sid(x[1]), "author": sname(x[2]), "kind": skind(x[3]),
                   "untrusted": {"text": clean(x[4], 600)}} for x in shown]
        nxt = events[-1]["id"] if events else args.get("after", 0)
        lines = [("event %d %s %s by %s" % (e["id"], e["task_id"], e["kind"], e["author"]), e["untrusted"]["text"])
                 for e in events]
        return Reply("%d event(s); pass next_cursor as 'after' to continue." % len(events),
                     {"events": events, "next_cursor": nxt, "more": len(rows) > limit}, lines)

    def t_leases(self, args, call):
        now = int(time.time())
        items = [{"lease_id": lid, "task_id": v["task"], "lease_seconds": v["lease_s"], "age_seconds": max(now - v["at"], 0)}
                 for lid, v in self.leases.snapshot()] if self.leases else []
        return Reply("%d lease(s) held through this server." % len(items), {"agent": self.author or "", "leases": items})

    # write tools

    def t_add(self, args, call):
        bad = self.need_author() or self.check_texts(args, ("title", "body"))
        if bad:
            return bad
        argv = ["add"]
        if "priority" in args:
            argv += ["--priority", str(args["priority"])]
        if "parent" in args:
            argv += ["--parent", args["parent"]]
        if args.get("body"):
            argv += ["--body", args["body"]]
        if args.get("blocked_by"):
            argv += ["--blocked-by", ",".join(args["blocked_by"])]
        argv += ["--", args["title"]]
        r = self.helper.run(argv, call)
        if r.rc != 0:
            return self.classify(r, "adding the task")
        tid = r.out.strip().splitlines()[-1] if r.out.strip() else ""
        if not ID_RX.fullmatch(tid):
            return err_reply("internal", 0, "The board answered with something that is not a task id.")
        return Reply("Added task %s." % tid, {"task_id": tid})

    def check_texts(self, args, names):
        for n in names:
            v = args.get(n)
            if v is None:
                continue
            why = bad_input_char(v)
            if why:
                return err_reply("invalid_input", 0, "Invalid input: %s contains %s." % (n, why))
            if n in ("title", "text", "reason") and not v.strip():
                return err_reply("invalid_input", 0, "Invalid input: %s is empty." % n)
            if len(v.encode("utf-8")) > 4096:
                return err_reply("invalid_input", 0, "Invalid input: %s is longer than 4096 bytes." % n)
        return None

    def t_next(self, args, call):
        bad = self.need_author()
        if bad:
            return bad
        lease_s = args.get("lease_seconds", 600)
        r = self.helper.run(["next", "--lease", str(lease_s)], call)
        if r.rc == 4:
            if "at capacity" in r.err:
                return err_reply("at_capacity", 4, "You already hold a task. Finish it (board_done, board_fail) or "
                                 "give it back (board_release) before taking another.")
            return Reply("Nothing is runnable right now.", {"claimed": False, "reason": "nothing_runnable"})
        if r.rc != 0:
            return self.classify(r, "taking the next task")
        tid = r.out.strip().splitlines()[-1] if r.out.strip() else ""
        if not ID_RX.fullmatch(tid):
            return err_reply("internal", 0, "The board answered with something that is not a task id.")
        return self.take(call, tid, lease_s, "Claimed task")

    def t_claim(self, args, call):
        bad = self.need_author()
        if bad:
            return bad
        lease_s = args.get("lease_seconds", 600)
        r = self.helper.run(["claim", "--lease", str(lease_s), "--", args["task_id"]], call)
        if r.rc != 0:
            return self.classify(r, "claiming the task")
        return self.take(call, args["task_id"], lease_s, "Claimed task", already="already yours" in r.out)

    def with_lease(self, args, call, action, build):
        """Run a write that needs a lease: BUILD(lease) gives the helper argv."""
        bad = self.need_author()
        if bad:
            return bad, None, None
        lease, bad = self.lease_for(args)
        if bad:
            return bad, None, None
        r = self.helper.run(build(lease), call)
        if r.rc == 3:
            self.leases.drop(args["lease_id"])
        if r.rc != 0:
            return self.classify(r, action), None, None
        return None, r, lease

    def t_heartbeat(self, args, call):
        lease_s = args.get("lease_seconds", 600)
        bad, r, _ = self.with_lease(args, call, "the heartbeat", lambda l: [
            "heartbeat", "--lease", str(lease_s), "--fence", str(l["fence"]), "--", l["task"]])
        if bad:
            return bad
        m = re.search(r"runs until (\d+)", r.out)
        self.leases.touch(args["lease_id"], lease_s)
        return Reply("Lease extended.", {"lease_until": int(m.group(1)) if m else 0})

    def t_note(self, args, call):
        bad = self.check_texts(args, ("text",))
        if bad:
            return bad
        bad, r, _ = self.with_lease(args, call, "the note", lambda l: [
            "note", "--fence", str(l["fence"]), "--", l["task"], args["text"]])
        if bad:
            return bad
        m = re.search(r"as event (\d+)", r.out)
        return Reply("Note added.", {"event_id": int(m.group(1)) if m else 0})

    def t_done(self, args, call):
        bad = self.check_texts(args, ("summary",))
        if bad:
            return bad

        def build(l):
            argv = ["done", "--fence", str(l["fence"]), "--", l["task"]]
            if args.get("summary"):
                argv.append(args["summary"])
            return argv
        bad, r, _ = self.with_lease(args, call, "finishing the task", build)
        if bad:
            return bad
        self.leases.drop(args["lease_id"])
        already = "already done" in r.out
        return Reply("The task was already done; nothing changed." if already else "Task marked done.",
                     {"already_done": already})

    def t_fail(self, args, call):
        bad = self.check_texts(args, ("reason",))
        if bad:
            return bad

        def build(l):
            argv = ["fail", "--fence", str(l["fence"])]
            if "retry_in_seconds" in args:
                argv += ["--retry-in", str(args["retry_in_seconds"])]
            return argv + ["--", l["task"], args["reason"]]
        bad, r, _ = self.with_lease(args, call, "failing the task", build)
        if bad:
            return bad
        self.leases.drop(args["lease_id"])
        m = re.search(r"open again in (\d+) seconds", r.out)
        if m:
            return Reply("Task given back; it can be claimed again in %s seconds." % m.group(1),
                         {"outcome": "retry", "retry_in_seconds": int(m.group(1))})
        return Reply("Task given back; it has no attempts left and is now dead.", {"outcome": "dead"})

    def t_release(self, args, call):
        bad, r, _ = self.with_lease(args, call, "releasing the task", lambda l: [
            "release", "--fence", str(l["fence"]), "--", l["task"]])
        if bad:
            return bad
        self.leases.drop(args["lease_id"])
        return Reply("Task released.", {"released": True})


# ---- the queue, as the console sorts it (integrations/console/console/model.py, build_queue) --------


def build_queue(text, me, limit):
    now = 0
    tasks, leases, blockers = [], {}, {}
    for line in text.split("\n"):
        p = line.rstrip("\r").split("\t")
        tag = p[0]
        if tag == "now" and len(p) > 1:
            now = to_int(p[1])
        elif tag == "task" and len(p) >= 8:
            if not ID_RX.fullmatch(p[1]) or p[2] not in STATE_SET:
                continue
            p[4] = sname(p[4])
            tasks.append({"id": p[1], "state": p[2], "priority": to_int(p[3]), "owner": p[4],
                          "created_at": to_int(p[5]), "created_seq": to_int(p[6]), "title": "\t".join(p[7:])})
        elif tag == "lease" and len(p) >= 2 and ID_RX.fullmatch(p[1]):
            p += [""] * (9 - len(p))
            leases[p[1]] = {"lease_until": to_int(p[2]), "heartbeat_at": to_int(p[3]), "attempts": to_int(p[4]),
                            "max_attempts": to_int(p[5], 3), "not_before": to_int(p[6]), "last_error": p[7],
                            "blocked_by": [b for b in p[8].split(",") if ID_RX.fullmatch(b)]}
        elif tag == "blocker" and len(p) >= 3 and ID_RX.fullmatch(p[1]):
            blockers[p[1]] = p[2] if p[2] in STATE_SET else "?"
    by_id = {t["id"]: t for t in tasks}
    empty = {"lease_until": 0, "heartbeat_at": 0, "attempts": 0, "max_attempts": 3, "not_before": 0,
             "last_error": "", "blocked_by": []}
    waits = {t["id"]: leases.get(t["id"], empty)["blocked_by"] for t in tasks}

    def in_cycle(start):
        seen, stack = set(), list(waits.get(start, []))
        while stack:
            cur = stack.pop()
            if cur == start:
                return True
            if cur in seen:
                continue
            seen.add(cur)
            stack.extend(waits.get(cur, []))
        return False

    secs = {k: [] for k in QUEUE_SECTIONS}
    window_cut = len(tasks) >= 200
    for t in tasks:  # already in priority, creation order
        ls = leases.get(t["id"], empty)
        base = {"id": t["id"], "priority": t["priority"], "attempts": ls["attempts"],
                "max_attempts": ls["max_attempts"], "untrusted": {"title": clean(t["title"], 300)}}
        st = t["state"]
        if st == "open":
            pending = []
            for b in waits[t["id"]]:
                bs = blockers.get(b) or (by_id[b]["state"] if b in by_id else None)
                if bs == "done":
                    continue
                pending.append({"id": b, "state": bs or "missing"})
            if pending:
                cyc = in_cycle(t["id"])
                forever = cyc or any(x["state"] in ("dead", "cancelled", "missing") for x in pending)
                secs["blocked"].append(dict(base, blockers=pending[:32], forever=forever))
            elif ls["not_before"] > now:
                secs["retrying"].append(dict(base, wait_seconds=ls["not_before"] - now,
                                             untrusted={"title": clean(t["title"], 300),
                                                        "last_error": clean(ls["last_error"], 300)}))
            else:
                secs["runnable"].append(dict(base, age_seconds=max(now - t["created_at"], 0)))
        elif st == "claimed":
            until = ls["lease_until"]
            secs["claimed"].append(dict(base, owner=t["owner"], mine=bool(me) and t["owner"] == me,
                                        remaining_seconds=(until - now) if until else None,
                                        expired=bool(until) and until < now,
                                        heartbeat_age_seconds=(max(now - ls["heartbeat_at"], 0) if ls["heartbeat_at"] else None)))
        elif st == "dead":
            secs["dead"].append(dict(base, untrusted={"title": clean(t["title"], 300),
                                                      "last_error": clean(ls["last_error"], 300)}))
        elif st == "awaiting_approval":
            secs["awaiting_approval"].append(dict(base, age_seconds=max(now - t["created_at"], 0)))
    secs["claimed"].sort(key=lambda r: (r["remaining_seconds"] is None, r["remaining_seconds"] or 0))
    secs["retrying"].sort(key=lambda r: r["wait_seconds"])
    totals = {k: len(v) for k, v in secs.items()}
    out = {k: v[:limit] for k, v in secs.items()}
    out["totals"] = totals
    out["truncated"] = {k: totals[k] > limit for k in totals}
    out["now"] = now
    out["window_cut"] = window_cut
    return out


# ---- JSON-RPC --------------------------------------------------------------------------------------


class RpcError(Exception):
    def __init__(self, code, message, data=None):
        Exception.__init__(self, message)
        self.code = code
        self.message = message
        self.data = data


def _dupes(pairs):
    d = {}
    for k, v in pairs:
        if k in d:
            raise ValueError("duplicate key")
        d[k] = v
    return d


def _constant(_name):
    raise ValueError("not JSON")


def too_deep(value):
    """True when VALUE nests deeper than MAX_DEPTH or holds more than MAX_VALUES values."""
    count = 0
    stack = [(value, 1)]
    while stack:
        v, d = stack.pop()
        count += 1
        if d > MAX_DEPTH or count > MAX_VALUES:
            return True
        if isinstance(v, dict):
            stack.extend((x, d + 1) for x in v.values())
        elif isinstance(v, list):
            stack.extend((x, d + 1) for x in v)
    return False


class Call:
    def __init__(self, key):
        self.key = key
        self.cancelled = threading.Event()
        self.proc = None


class Session:
    """One stdio connection: the JSON-RPC layer over a Server."""

    def __init__(self, server, out):
        self.server = server
        self.out = out
        self.write_lock = threading.Lock()
        self.mode = "stateless"
        self.calls = {}
        self.calls_lock = threading.Lock()
        self.threads = []
        self.closing = False

    # output

    def send(self, obj):
        data = json.dumps(obj, ensure_ascii=True, separators=(",", ":"))
        if len(data) > MAX_OUT:
            rid = obj.get("id")
            data = json.dumps({"jsonrpc": "2.0", "id": rid, "error": {"code": -32603, "message": "result too large"}})
        with self.write_lock:
            try:
                self.out.write(data + "\n")
                self.out.flush()
            except (OSError, ValueError):
                self.closing = True

    def reply_error(self, rid, code, message, data=None):
        e = {"code": code, "message": message}
        if data is not None:
            e["data"] = data
        self.send({"jsonrpc": "2.0", "id": rid, "error": e})

    # input

    def handle_line(self, raw):
        """One inbound line (bytes without the newline)."""
        try:
            text = raw.decode("utf-8")
            msg = json.loads(text, object_pairs_hook=_dupes, parse_constant=_constant)
        except (UnicodeDecodeError, ValueError, RecursionError):
            return self.reply_error(None, -32700, "parse error")
        if too_deep(msg):
            return self.reply_error(None, -32600, "message too deeply nested or too large")
        if isinstance(msg, list):
            return self.reply_error(None, -32600, "batches are not supported")
        if not isinstance(msg, dict):
            return self.reply_error(None, -32600, "invalid request")
        has_id = "id" in msg
        rid = msg.get("id")
        if has_id and (isinstance(rid, bool) or not isinstance(rid, (str, int))):
            return self.reply_error(None, -32600, "id must be a string or an integer")
        if isinstance(rid, str) and len(rid) > MAX_ID:
            return self.reply_error(None, -32600, "id is longer than %d characters" % MAX_ID)
        if set(msg) - {"jsonrpc", "id", "method", "params"} or msg.get("jsonrpc") != "2.0":
            return self.reply_error(rid if has_id else None, -32600, "invalid request")
        method = msg.get("method")
        if not isinstance(method, str):
            return self.reply_error(rid if has_id else None, -32600, "invalid request")
        params = msg.get("params")
        if "params" in msg and not isinstance(params, dict):
            return self.reply_error(rid if has_id else None, -32600, "params must be an object")
        if not has_id:
            try:
                self.notification(method, params or {})
            except Exception:  # a notification is never answered and never fatal
                log("internal error in a notification")
            return None
        try:
            self.request(rid, method, params)
        except RpcError as e:
            self.reply_error(rid, e.code, e.message, e.data)
        except Exception:  # never let one request end the server
            log("internal error while handling %s" % clean(method, 60))
            self.reply_error(rid, -32603, "internal error")

    def notification(self, method, params):
        if method == "notifications/cancelled":
            rid = params.get("requestId")
            if not (isinstance(rid, str) or (isinstance(rid, int) and not isinstance(rid, bool))):
                return  # an unhashable or odd id names no request
            with self.calls_lock:
                call = self.calls.get((type(rid).__name__, rid))
            if call:
                call.cancelled.set()
                proc = call.proc
                if proc is not None:
                    Helper.kill(proc)
        # every other notification, including notifications/initialized, is accepted and not answered

    def check_meta(self, params):
        p = params or {}
        if "_meta" not in p:
            if self.mode == "stateless":
                raise RpcError(-32602, "missing required _meta", {"field": "_meta"})
            return
        meta = p["_meta"]
        if not isinstance(meta, dict):
            raise RpcError(-32602, "_meta must be an object", {"field": "_meta"})
        version = meta.get(META_VERSION)
        caps = meta.get(META_CAPS)
        supported = [MODERN] if self.mode == "stateless" else [MODERN, LEGACY]
        if version is None:
            if self.mode == "stateless":
                raise RpcError(-32602, "missing required _meta field", {"field": META_VERSION})
        elif not (isinstance(version, str) and version in supported):
            data = {"supported": supported}
            if isinstance(version, str) and len(version) <= 32 and re.fullmatch(r"[A-Za-z0-9._-]+", version):
                data["requested"] = version
            raise RpcError(-32022, "unsupported protocol version", data)
        if caps is None:
            if self.mode == "stateless":
                raise RpcError(-32602, "missing required _meta field", {"field": META_CAPS})
        elif not isinstance(caps, dict):
            raise RpcError(-32602, "_meta field has the wrong type", {"field": META_CAPS})

    def request(self, rid, method, params):
        info = {"name": "board-mcp", "version": VERSION}
        if method == "initialize":
            ok = (params is not None and isinstance(params.get("protocolVersion"), str)
                  and isinstance(params.get("capabilities"), dict) and isinstance(params.get("clientInfo"), dict))
            if not ok:
                raise RpcError(-32602, "invalid initialize parameters")
            self.mode = "legacy"
            return self.send({"jsonrpc": "2.0", "id": rid, "result": {
                "resultType": "complete", "protocolVersion": LEGACY,
                "capabilities": {"tools": {"listChanged": False}}, "serverInfo": info,
                "instructions": INSTRUCTIONS}})
        if method not in ("ping", "server/discover", "tools/list", "tools/call"):
            raise RpcError(-32601, "method not found")
        self.check_meta(params)
        if method == "ping":
            return self.send({"jsonrpc": "2.0", "id": rid, "result": {"resultType": "complete"}})
        if method == "server/discover":
            versions = [MODERN] if self.mode == "stateless" else [MODERN, LEGACY]
            return self.send({"jsonrpc": "2.0", "id": rid, "result": {
                "resultType": "complete", "supportedVersions": versions, "capabilities": {"tools": {}},
                "instructions": INSTRUCTIONS, "_meta": {"io.modelcontextprotocol/serverInfo": info}}})
        if method == "tools/list":
            return self.send({"jsonrpc": "2.0", "id": rid, "result": {
                "resultType": "complete", "tools": [self.server.tools[n].spec for n in self.server.order]}})
        self.tools_call(rid, params or {})

    def tools_call(self, rid, params):
        if set(params) - {"name", "arguments", "_meta"}:
            raise RpcError(-32602, "unknown parameter")
        name = params.get("name")
        if not isinstance(name, str):
            raise RpcError(-32602, "missing required argument", {"field": "name"})
        tool = self.server.tools.get(name)
        if tool is None:
            raise RpcError(-32602, "unknown tool")
        args = params.get("arguments", {})
        if not isinstance(args, dict):
            raise RpcError(-32602, "arguments must be an object", {"field": "arguments"})
        problem = validate(tool.spec["inputSchema"], args)
        if problem is not None:
            return self.send({"jsonrpc": "2.0", "id": rid, "result": render(
                err_reply("invalid_input", 0, "Invalid input: %s." % problem))})
        args = {k: (int(v) if isinstance(v, float) else v) for k, v in args.items()}  # 5.0 is the integer 5
        key = (type(rid).__name__, rid)
        with self.calls_lock:
            if key in self.calls:
                raise RpcError(-32600, "a request with this id is already in progress")
            if len(self.calls) >= MAX_PENDING:
                raise RpcError(-32603, "too many requests in progress")
            call = Call(key)
            self.calls[key] = call
        t = threading.Thread(target=self.run_tool, args=(rid, tool, args, call), daemon=True)
        self.threads = [x for x in self.threads if x.is_alive()] + [t]
        t.start()

    def run_tool(self, rid, tool, args, call):
        started = time.monotonic()
        code = "-"
        try:
            try:
                reply = tool.fn(args, call)
            except Cancelled:
                code = "cancelled"
                return
            except Exception:
                log("internal error in %s" % tool.name)
                reply = err_reply("internal", 0, "The board server hit an internal error. Nothing is known about "
                                  "the outcome of this call; check the task before repeating a write.")
            if call.cancelled.is_set():
                code = "cancelled"
                return
            if reply.error:
                code = reply.error["code"]
            self.send({"jsonrpc": "2.0", "id": rid, "result": render(reply)})
        finally:
            with self.calls_lock:
                self.calls.pop(call.key, None)
            log("call %s -> %s in %d ms" % (tool.name, code, int((time.monotonic() - started) * 1000)))

    def serve(self, stream):
        """Read lines until EOF. A line over MAX_LINE is refused and skipped."""
        while not self.closing:
            raw = stream.readline(MAX_LINE + 1)
            if not raw:
                break
            if len(raw) > MAX_LINE and not raw.endswith(b"\n"):
                while True:  # skip the rest of the line
                    rest = stream.readline(65536)
                    if not rest or rest.endswith(b"\n"):
                        break
                self.reply_error(None, -32600, "message too large (limit %d bytes)" % MAX_LINE)
                continue
            raw = raw.rstrip(b"\r\n")
            if raw.strip():
                try:
                    self.handle_line(raw)
                except Exception:  # no single message may end the server
                    log("internal error while handling a message")
                    self.reply_error(None, -32603, "internal error")
        deadline = time.monotonic() + 5
        for t in list(self.threads):
            t.join(timeout=max(deadline - time.monotonic(), 0))
        self.server.helper.kill_all()


# ---- start-up --------------------------------------------------------------------------------------


def build_server(environ=None):
    env = os.environ if environ is None else environ
    here = os.path.dirname(os.path.realpath(__file__))
    path = env.get("BOARD_MCP_BOARD") or os.path.join(here, "board")
    author = env.get("BOARD_AUTHOR", "")
    problem = None
    if not author:
        problem = "BOARD_AUTHOR is not set. Set it to this agent's unique name in the server's environment."
    elif not NAME_RX.fullmatch(author):
        problem = "BOARD_AUTHOR must use only letters, digits, '.', '_' and '-' (at most 64 characters)."
        author = ""
    if not os.access(path, os.X_OK):
        problem = problem or "the board helper %s is not executable." % path
    try:
        timeout = float(env.get("BOARD_MCP_TIMEOUT") or DEFAULT_TIMEOUT)
        helpers = int(env.get("BOARD_MCP_HELPERS") or DEFAULT_HELPERS)
    except ValueError:
        timeout, helpers = DEFAULT_TIMEOUT, DEFAULT_HELPERS
    timeout = min(max(timeout, 1.0), 300.0)
    helpers = min(max(helpers, 1), 16)
    helper = Helper(path, author, timeout, helpers)
    state = env.get("BOARD_STATE_DIR") or os.path.join(
        env.get("XDG_STATE_HOME") or os.path.join(env.get("HOME") or ".", ".local", "state"), "lattice-board")
    leases = None
    if author:
        try:
            leases = Leases(private_dir(state), author)
        except ValueError as e:
            problem = problem or str(e)
    return Server(helper, author, leases, problem)


def digest(environ=None):
    """The text of the SessionStart hook (read only): counts of the queue, the ids of what could be
    taken next, and what this agent holds. Never a title or any other board text, because the hook's
    output goes into the model's context as instructions-adjacent text and titles are untrusted.
    Returns None when no board is configured (the hook then prints nothing)."""
    env = os.environ if environ is None else environ
    if not (env.get("LATTICE_BOARD_URL") or env.get("PGHOST")):
        return None
    server = build_server(env)
    server.helper.timeout = 8.0  # the hook's own timeout is 15 s; the helper group is killed on expiry
    call = Call(("digest", 0))
    r = server.helper.run(["queue"], call)
    if r.rc != 0:
        return "Task board: configured, but the queue could not be read (%s). Use board_queue to see why." % (
            "the helper timed out" if r.timed_out else "the database or the helper reported an error")
    q = build_queue(r.out, server.author, 5)
    t = q["totals"]
    parts = ["Task board: %d runnable, %d blocked, %d claimed, %d retrying, %d dead, %d awaiting approval." % (
        t["runnable"], t["blocked"], t["claimed"], t["retrying"], t["dead"], t["awaiting_approval"])]
    if q["runnable"]:
        parts.append("Next runnable (by id; read titles with board_show, they are untrusted text): %s." %
                     ", ".join("%s (priority %d)" % (x["id"], x["priority"]) for x in q["runnable"]))
    mine = [x for x in q["claimed"] if x["mine"]]
    if server.author and mine:
        parts.append("%s holds: %s." % (server.author, ", ".join(
            "%s (%s)" % (x["id"], "lease expired" if x["expired"] else "%ss left" % x["remaining_seconds"]) for x in mine)))
    elif not server.author:
        parts.append("BOARD_AUTHOR is not set, so this session can read the board but not write to it.")
    parts.append("Take work with board_next; hold one task at a time; stop when a write says the lease is lost.")
    return " ".join(parts)


def main(argv):
    if argv == ["--digest"]:
        # Always exit 0 and print at most one JSON object: a hook must never break a session.
        try:
            text = digest()
        except Exception:
            text = None
        if text:
            sys.stdout.write(json.dumps({"hookSpecificOutput": {"hookEventName": "SessionStart",
                                                                 "additionalContext": text}}) + "\n")
        return 0
    if argv and argv[0] in ("-h", "--help"):
        sys.stdout.write(__doc__.split("\n\n", 1)[0] + "\n\nEnvironment: BOARD_AUTHOR (required for writes), "
                         "BOARD_MCP_BOARD, BOARD_MCP_TIMEOUT, BOARD_MCP_HELPERS, BOARD_MCP_PASS_ENV, BOARD_STATE_DIR, "
                         "LATTICE_BOARD_URL, PG*.\n--digest prints the SessionStart hook output and exits.\n")
        return 0
    if argv:
        log("takes no arguments")
        return 2
    server = build_server()
    log("started %s as %s%s" % (VERSION, server.author or "(no author)",
                                "" if not server.config_error else "; not configured: " + server.config_error))
    session = Session(server, sys.stdout)

    def stop(_sig, _frame):
        server.helper.kill_all()
        os._exit(143)
    for s in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP):
        signal.signal(s, stop)
    signal.signal(signal.SIGPIPE, signal.SIG_IGN)
    session.serve(sys.stdin.buffer)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
